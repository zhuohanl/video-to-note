{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "loginUsername": {
      "value": "${VTN_USERNAME}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "vtnPasswordHash": {
      "value": "${VTN_PASSWORD_HASH}"
    },
    "vtnCookieSecret": {
      "value": "${VTN_COOKIE_SECRET}"
    },
    "openAiChatDeploymentName": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT}"
    },
    "openAiChatModelName": {
      "value": "${AZURE_OPENAI_CHAT_MODEL}"
    },
    "openAiChatModelVersion": {
      "value": "${AZURE_OPENAI_CHAT_MODEL_VERSION}"
    },
    "openAiEmbedDeploymentName": {
      "value": "${AZURE_OPENAI_EMBED_DEPLOYMENT}"
    },
    "openAiEmbedModelName": {
      "value": "${AZURE_OPENAI_EMBED_MODEL}"
    },
    "openAiEmbedModelVersion": {
      "value": "${AZURE_OPENAI_EMBED_MODEL_VERSION}"
    },
    "openAiDeploymentSku": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_SKU}"
    },
    "openAiChatDeploymentCapacity": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT_CAPACITY}"
    },
    "openAiEmbedDeploymentCapacity": {
      "value": "${AZURE_OPENAI_EMBED_DEPLOYMENT_CAPACITY}"
    }
  }
}
